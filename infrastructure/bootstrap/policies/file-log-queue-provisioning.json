{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageMMIVFileLogQueues",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:DeleteQueue",
        "sqs:GetQueueAttributes",
        "sqs:SetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:TagQueue",
        "sqs:UntagQueue",
        "sqs:ListQueueTags"
      ],
      "Resource": [
        "arn:aws:sqs:${aws_region}:${aws_account_id}:mmiv-file-logs",
        "arn:aws:sqs:${aws_region}:${aws_account_id}:mmiv-file-logs-dead-letter"
      ]
    }
  ]
}
