{
  "uid": "mmiv-integrity",
  "title": "MMIV Integrity validation",
  "tags": [
    "mmiv",
    "integrity"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Validation rate by replica",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mmiv-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (replica) (rate(mmiv_integrity_validation_seconds_count{service=\"integrity-service\"}[5m]))",
          "legendFormat": "{{replica}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 2,
      "title": "Mean validation duration by replica",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mmiv-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (replica) (rate(mmiv_integrity_validation_seconds_sum{service=\"integrity-service\"}[5m])) / sum by (replica) (rate(mmiv_integrity_validation_seconds_count{service=\"integrity-service\"}[5m]))",
          "legendFormat": "{{replica}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 3,
      "title": "P95 validation duration by replica",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mmiv-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, replica) (rate(mmiv_integrity_validation_seconds_bucket{service=\"integrity-service\"}[5m])))",
          "legendFormat": "{{replica}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 4,
      "title": "Validation outcomes by replica",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mmiv-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (replica, outcome) (rate(mmiv_integrity_validation_seconds_count{service=\"integrity-service\"}[5m]))",
          "legendFormat": "{{replica}} {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    }
  ]
}
